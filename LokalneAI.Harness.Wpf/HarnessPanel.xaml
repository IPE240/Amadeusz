<UserControl x:Class="LokalneAI.Harness.Wpf.HarnessPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LokalneAI.Harness.Wpf"
             FontFamily="Segoe UI" FontSize="13" Background="#F4F5F7"
             MinWidth="320" MinHeight="300">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Selectable" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type local:PanelEntry}">
            <Border x:Name="Card" Margin="0,0,0,6" Padding="10,6" CornerRadius="6" Background="#F3F4F6">
                <DockPanel>
                    <!-- Tokeny i czasy (HarnessPanel.ShowTokens): z prawej w szerokim oknie, pod wpisem w wąskim. -->
                    <Border x:Name="MetricsBox" DockPanel.Dock="Right" Width="270" Margin="12,0,0,0" Padding="8,0,0,0"
                            BorderBrush="#D1D5DB" BorderThickness="1,0,0,0" VerticalAlignment="Top" Visibility="Collapsed"
                            ToolTip="{x:Static local:HarnessPanel.TokensLegend}" ToolTipService.ShowDuration="60000">
                        <TextBlock Text="{Binding Metrics}" FontSize="11" Foreground="#4B5563" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock x:Name="MarkText" DockPanel.Dock="Left" Text="{Binding Mark}" Margin="0,0,6,0" FontWeight="Bold" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBox x:Name="MainText" Text="{Binding Text, Mode=OneWay}" Style="{StaticResource Selectable}" />
                        <!-- Odpowiedź i pytanie modelu: Markdown (tabele, listy, pogrubienia). -->
                        <local:MarkdownText x:Name="RichText" Markdown="{Binding Text, Mode=OneWay}" Visibility="Collapsed" />
                        <TextBox Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource Selectable}" FontSize="12" Foreground="#4B5563"
                                 Margin="0,2,0,0" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                        <!-- Pytanie o zgodę: odpowiedź w rozmowie, bez wyskakującego okna. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,2" Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                            <Button x:Name="YesButton" Content="Tak, wykonaj" MinWidth="110" Padding="10,3" Margin="0,0,8,0" Click="ConfirmYes_Click" FontWeight="SemiBold" />
                            <Button x:Name="NoButton" Content="Nie" MinWidth="80" Padding="10,3" Click="ConfirmNo_Click" />
                        </StackPanel>
                        <!-- Podagent: przebieg jego sesji jako rozwijane drzewo (ten sam szablon wpisu, zagnieżdżony). -->
                        <StackPanel x:Name="ChildrenBox" Visibility="Collapsed" Margin="0,4,0,0">
                            <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" Content="{Binding ChildrenText}" HorizontalAlignment="Left"
                                          Padding="6,1" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="#4338CA" Cursor="Hand"
                                          Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{DynamicResource EntryTemplate}" Margin="14,4,0,0"
                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Agent">
                    <Setter TargetName="Card" Property="Background" Value="#EEF2FF" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="#C7D2FE" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="3,1,1,1" />
                    <Setter TargetName="MainText" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="ChildrenBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Step">
                    <Setter TargetName="Card" Property="Background" Value="#F8FAFC" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="#E2E8F0" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="1" />
                    <Setter TargetName="MainText" Property="Foreground" Value="#475569" />
                    <Setter TargetName="MainText" Property="FontSize" Value="12" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Kind}" Value="Step" />
                        <Condition Binding="{Binding ShowModelSteps, RelativeSource={RelativeSource AncestorType={x:Type local:HarnessPanel}}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Card" Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="User">
                    <Setter TargetName="Card" Property="Background" Value="#E8F0FE" />
                    <Setter TargetName="MainText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Call">
                    <Setter TargetName="Card" Property="Background" Value="White" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="#E5E7EB" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="1" />
                    <Setter TargetName="MainText" Property="FontFamily" Value="Consolas" />
                    <Setter TargetName="MainText" Property="FontSize" Value="12" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Success}" Value="False">
                    <Setter TargetName="MarkText" Property="Foreground" Value="#B91C1C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Success}" Value="True">
                    <Setter TargetName="MarkText" Property="Foreground" Value="#15803D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Answer">
                    <Setter TargetName="Card" Property="Background" Value="#ECFDF5" />
                    <Setter TargetName="MainText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RichText" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Question">
                    <Setter TargetName="Card" Property="Background" Value="#FFF7E6" />
                    <Setter TargetName="MainText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RichText" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                    <Setter TargetName="Card" Property="Background" Value="#FFF7E6" />
                    <Setter TargetName="MainText" Property="Foreground" Value="#92400E" />
                    <Setter TargetName="MainText" Property="FontSize" Value="12" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter TargetName="Card" Property="Background" Value="#FEF2F2" />
                    <Setter TargetName="MainText" Property="Foreground" Value="#B91C1C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Confirm">
                    <Setter TargetName="Card" Property="Background" Value="#FFF7E6" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="#F5C46B" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="1" />
                    <Setter TargetName="MarkText" Property="Foreground" Value="#B45309" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Dangerous}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="#FEF2F2" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="#F2A7A7" />
                    <Setter TargetName="YesButton" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="NoButton" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Info">
                    <Setter TargetName="Card" Property="Background" Value="Transparent" />
                    <Setter TargetName="MainText" Property="Foreground" Value="#6B7280" />
                    <Setter TargetName="MainText" Property="FontSize" Value="12" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ShowTokens, RelativeSource={RelativeSource AncestorType={x:Type local:HarnessPanel}}}" Value="True" />
                        <Condition Binding="{Binding HasMetrics}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="MetricsBox" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding TokensBeside, RelativeSource={RelativeSource AncestorType={x:Type local:HarnessPanel}}}" Value="False">
                    <Setter TargetName="MetricsBox" Property="DockPanel.Dock" Value="Bottom" />
                    <Setter TargetName="MetricsBox" Property="Width" Value="NaN" />
                    <Setter TargetName="MetricsBox" Property="Margin" Value="0,4,0,0" />
                    <Setter TargetName="MetricsBox" Property="BorderThickness" Value="0,1,0,0" />
                    <Setter TargetName="MetricsBox" Property="Padding" Value="0,3,0,0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Nagłówek: tytuł, licznik kontekstu, nowa sesja -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Asystent" FontWeight="SemiBold" FontSize="14" />
                <Grid Margin="0,4,0,0" ToolTip="Ile kontekstu modelu zajmuje ta sesja. Przy zapełnieniu starsza część rozmowy jest skracana.">
                    <ProgressBar x:Name="ContextBar" Height="14" Maximum="100" Value="0" Foreground="#3B82F6" Background="#E5E7EB" BorderThickness="0" />
                    <TextBlock x:Name="ContextText" Text="Kontekst: —" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#111827" />
                </Grid>
            </StackPanel>
            <Button Grid.Column="1" x:Name="NewSessionButton" Content="Nowa sesja" Margin="8,0,0,0" Padding="10,3" VerticalAlignment="Top"
                    Click="NewSession_Click" ToolTip="Zamyka bieżącą sesję i kasuje jej historię" />
        </Grid>

        <!-- Rozmowa -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE1E6" BorderThickness="1" CornerRadius="6">
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="8" PreviewMouseWheel="Scroll_PreviewMouseWheel">
                <ItemsControl x:Name="EntriesList" ItemTemplate="{StaticResource EntryTemplate}" />
            </ScrollViewer>
        </Border>

        <!-- Podagenci, którzy właśnie liczą: kafelek = podagent (komputer, model, krok, czas) z przyciskiem „Przerwij”. -->
        <ItemsControl x:Name="AgentTiles" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:AgentTile}">
                    <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,6" MinWidth="240" MaxWidth="420"
                            ToolTip="{Binding Task}" ToolTipService.ShowDuration="60000">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Przerwij" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Click="AgentCancel_Click"
                                    IsEnabled="{Binding IsRunning}" ToolTip="Przerywa tego jednego podagenta; agent główny dostanie informację o przerwaniu" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#4B5563" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Polecenie -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" MinHeight="54" MaxHeight="160" AcceptsReturn="True" TextWrapping="Wrap" Padding="6,4"
                     VerticalScrollBarVisibility="Auto" PreviewKeyDown="Input_PreviewKeyDown" DataObject.Pasting="Input_Pasting" />
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Button x:Name="SendButton" Content="Wyślij" Width="90" Height="30" Click="Send_Click" FontWeight="SemiBold" />
                <Button x:Name="StopButton" Content="Stop" Width="90" Height="24" Margin="0,6,0,0" Click="Stop_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
