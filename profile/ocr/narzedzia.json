      "zmienia_model": false,
      "parametry": {
        "type": "object",
        "properties": {
          "sciezka": {
            "type": "string",
            "description": "folder; pusta = folder bieżący"
          },
          "wzorzec": {
            "type": "string",
            "description": "np. *.jpg; pusty = wszystko"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "nazwa": "ocr_obraz",
      "opis": "Rozpoznaje tekst z obrazu (PNG, JPG, TIFF, BMP, GIF, WebP) i zwraca go z pewnością rozpoznania. Język i obrót z Ustawień → OCR, chyba że podano inaczej.",
      "zmienia_model": false,
      "parametry": {
        "type": "object",
        "properties": {
          "sciezka": {
