          "uklad": {
            "type": "string",
            "enum": ["auto", "tabela", "kolumna", "luzny"]
          },
          "zapisz_txt": {
            "type": "boolean",
            "description": "true = zapisz tekst obok pliku jako <nazwa>.ocr.txt"
          }
