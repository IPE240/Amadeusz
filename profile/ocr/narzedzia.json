          },
          "jezyk": {
            "type": "string",
            "description": "np. pol+eng; pusty = z ustawień"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "nazwa": "pdf_info",
      "opis": "Opisuje PDF: liczba stron, format, rozmiar, tytuł i czy strony mają warstwę tekstową (dokument) czy są skanami (OCR).",
