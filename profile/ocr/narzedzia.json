          },
          "zapisz_txt": {
            "type": "boolean",
            "description": "true = zapisz tekst obok pliku jako <nazwa>.ocr.txt"
          }
        },
        "required": [
          "sciezka"
        ],
        "additionalProperties": false
      }
    },
    {
