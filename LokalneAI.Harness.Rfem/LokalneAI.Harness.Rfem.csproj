<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Czytnik plików RFEM 5 (.rf5) bez programu Dlubal — umiejętność „rfem”. Plik to kontener ZIP (nowsze wersje) albo
    OLE Compound File (starsze); w środku strumień InputData (model: węzły, linie, pręty, przekroje, materiały, przypadki),
    tekstowa siatka Mesh\.geo i katalog wyników Results_Main_V_2 (siły w prętach .HXN<nr>). Format rozpoznany
    przez porównanie z modelami biura (docs w profile\rfem\README.md); bez paczek — własny czytnik OLE i ZIP z .NET.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>LokalneAI.Harness.Rfem</RootNamespace>
    <Product>LokalneAI</Product>
    <Version>0.1.0</Version>
    <Company>Optimal Design of Structures Sp. z o.o.</Company>
    <Copyright>Copyright (c) 2026 Optimal Design of Structures Sp. z o.o.</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LokalneAI.Harness\LokalneAI.Harness.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LokalneAI.Harness.Tests" />
  </ItemGroup>

</Project>
