<Window x:Class="LokalneAI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LokalneAI.App"
        Title="LokalneAI — okno testowe"
        Width="1000" Height="780" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        Background="#F4F5F7">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
    </Window.InputBindings>

    <Border x:Name="Root" Background="#F4F5F7" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Pasek górny: model, stan Ollamy, karta graficzna -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Model" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#374151" />
                <ComboBox Grid.Column="1" Width="420" Padding="6,5"
                          ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                          IsEnabled="{Binding IsIdle}" VerticalContentAlignment="Center" />
                <Button Grid.Column="2" Content="Odśwież" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                        ToolTip="Sprawdź jeszcze raz Ollamę i listę modeli" />
                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="{Binding OllamaStatus}" Foreground="{Binding OllamaStatusBrush}"
                               FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding GpuText}" Foreground="#6B7280" FontSize="12" HorizontalAlignment="Right" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="Pół-harness…" Click="OpenHarness_Click" Margin="0,0,8,0"
                            ToolTip="Okno z panelem do osadzania: profile Tekla (polecenia) i CDE (pytania do bazy)" />
                    <Button Content="Zwolnij pamięć GPU" Command="{Binding UnloadCommand}"
                            ToolTip="Wyrzuca model z pamięci karty graficznej, np. przed pracą w Tekli albo RFEM. Następne pytanie załaduje go ponownie." />
                </StackPanel>
            </Grid>

            <!-- Baner: co zrobić, gdy Ollama nie działa albo brakuje modelu -->
            <Border Grid.Row="1" Margin="0,0,0,10" Padding="12,10" CornerRadius="6"
                    Background="#FFF6E5" BorderBrush="#F0B35B" BorderThickness="1"
                    Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="Uruchom Ollamę" Command="{Binding StartOllamaCommand}" Margin="0,0,8,0"
                                Visibility="{Binding CanStartOllama, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Kopiuj polecenie instalacji" Command="{Binding CopyInstallCommand}" Margin="0,0,8,0"
                                Visibility="{Binding ShowInstallHint, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Pobierz model" Command="{Binding PullCommand}" Margin="0,0,8,0"
                                Visibility="{Binding CanPull, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Sprawdź ponownie" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" Foreground="#5B3A00" />
                        <ProgressBar Height="6" Margin="0,6,0,0" Maximum="100" Value="{Binding PullPercent, Mode=OneWay}"
                                     Visibility="{Binding IsPulling, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Rozmowa -->
            <Border Grid.Row="2" Background="White" BorderBrush="#DDE1E6" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" Padding="14,12"
                                  ScrollChanged="Transcript_ScrollChanged" PreviewMouseWheel="Transcript_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding Exchanges}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ExchangeViewModel}">
                                    <StackPanel Margin="0,0,0,18">
                                        <Border Background="#E8F0FE" CornerRadius="8" Padding="12,8" HorizontalAlignment="Left">
                                            <StackPanel>
                                                <TextBlock Text="Ty" FontSize="12" FontWeight="SemiBold" Foreground="#1A4FA0" />
                                                <TextBox Text="{Binding Question, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F3F4F6" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ModelLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#374151" />
                                                <TextBox Text="{Binding Answer, Mode=OneWay}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource ReadOnlyText}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="#B91C1C" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBlock Text="{Binding Stats}" FontSize="12" Foreground="#6B7280"
                                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Wpisz pytanie na dole i naciśnij Enter albo „Wyślij”.&#x0a;Odpowiedź liczy model na tym komputerze, bez internetu."
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="#9CA3AF" TextWrapping="Wrap" MaxWidth="460" IsHitTestVisible="False"
                               Visibility="{Binding IsTranscriptEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <!-- Pytanie -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="QuestionBox" Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="220"
                             VerticalScrollBarVisibility="Auto" Padding="8,6"
                             PreviewKeyDown="QuestionBox_PreviewKeyDown" />
                    <TextBlock Text="Zadaj pytanie…  (Enter wysyła, Shift+Enter nowa linia)" Margin="12,8,0,0"
                               Foreground="#9CA3AF" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=QuestionBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <Button Content="Wyślij" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}"
                            Width="120" Height="38" />
                    <Button Content="Stop" Command="{Binding StopCommand}" Width="120" Margin="0,8,0,0"
                            ToolTip="Przerywa odpowiedź albo pobieranie (Esc)" />
                </StackPanel>
            </Grid>

            <!-- Ustawienia -->
            <Expander x:Name="SettingsExpander" Grid.Row="4" Header="Ustawienia" Margin="0,10,0,0">
                <Grid Margin="4,8,0,0" IsEnabled="{Binding IsIdle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Polecenie systemowe" Margin="0,4,12,0" VerticalAlignment="Top" />
                    <TextBox Grid.Column="1" Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" Padding="4,2"
                             ToolTip="Instrukcja dla modelu dodawana przed każdym pytaniem. Puste pole = bez instrukcji." />

                    <TextBlock Grid.Row="1" Text="Parametry" Margin="0,10,12,0" VerticalAlignment="Center" />
                    <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                        <TextBlock Text="Temperatura" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="56" Text="{Binding TemperatureText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" Padding="4,2"
                                 ToolTip="0 = zawsze ta sama odpowiedź, wyżej = swobodniej. SpeakLeash zaleca dla Bielika 0,1." />
                        <TextBlock Text="Kontekst" VerticalAlignment="Center" Margin="18,0,6,0" />
                        <ComboBox Width="90" ItemsSource="{Binding ContextChoices}" SelectedItem="{Binding ContextLength}"
                                  ToolTip="Ile tokenów model widzi naraz. Więcej = więcej pamięci karty graficznej i wolniej." />
                        <CheckBox Content="Pamiętaj rozmowę" IsChecked="{Binding RememberConversation}"
                                  VerticalAlignment="Center" Margin="18,0,0,0"
                                  ToolTip="Wysyłaj modelowi wcześniejsze pytania i odpowiedzi. Wyłączone: każde pytanie liczy się od zera." />
                        <CheckBox Content="Zapisuj historię na tym PC" IsChecked="{Binding SaveHistory}"
                                  VerticalAlignment="Center" Margin="18,0,0,0" ToolTip="{Binding HistoryPath}" />
                    </WrapPanel>

                    <TextBlock Grid.Row="2" Text="Adres Ollamy" Margin="0,10,12,0" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" LastChildFill="False">
                        <TextBox Width="320" Text="{Binding OllamaUrl, UpdateSourceTrigger=LostFocus}"
                                 VerticalContentAlignment="Center" Padding="4,2" />
                        <Button DockPanel.Dock="Right" Content="Wyczyść rozmowę" Command="{Binding ClearCommand}" />
                    </DockPanel>
                </Grid>
            </Expander>

            <!-- Pasek stanu -->
            <TextBlock Grid.Row="5" Text="{Binding StatusText}" Margin="2,10,0,0" FontSize="12" Foreground="#4B5563"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</Window>
