<Window x:Class="LokalneAI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LokalneAI.App"
        xmlns:hw="clr-namespace:LokalneAI.Harness.Wpf;assembly=LokalneAI.Harness.Wpf"
        Title="LokalneAI"
        Width="1100" Height="820" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        StateChanged="Window_StateChanged">

    <!-- Wygląd jak TransmittalMaster: własny granatowy pasek tytułu z kartami, systemowa ramka ukryta. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Root" Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Pasek tytułu: nazwa, karty (Czat, Code, Ustawienia) i przyciski okna -->
        <DockPanel x:Name="TitleBar" Background="{StaticResource AccentDarkBrush}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimalizuj" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maksymalizuj" />
                <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Zamknij" />
            </StackPanel>
            <TextBlock Margin="16,0,18,0" VerticalAlignment="Center" DockPanel.Dock="Left"
                       FontSize="15" FontWeight="SemiBold" Foreground="White" Text="LokalneAI" />
            <ListBox x:Name="TabStrip" HorizontalAlignment="Left" DockPanel.Dock="Left"
                     Style="{StaticResource TitleTabStrip}" ItemContainerStyle="{StaticResource TitleTab}"
                     SelectedIndex="{Binding SelectedIndex, ElementName=Tabs, Mode=TwoWay}">
                <ListBoxItem Content="Czat" ToolTip="Rozmowa z modelem" />
                <ListBoxItem Content="Code" ToolTip="Asystent, który wykonuje polecenia: Tekla, baza CDE, pliki, PowerShell" />
                <ListBoxItem Content="Ustawienia" ToolTip="Gdzie liczyć, udostępnianie w sieci, kolejka, parametry czatu" />
            </ListBox>
            <!-- Temperatura karty komputera, który liczy: ostatnie 2 minuty i bieżąca wartość (bez kliknięć — pasek dalej przesuwa okno). -->
            <local:TemperatureGraph x:Name="TemperatureGraph" Margin="28,9,18,9" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="14,12,14,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Nagłówek: model (wspólny dla czatu i Code), stan Ollamy, karta i komputer, który liczy -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Model" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}" />
                <ComboBox x:Name="ModelBox" Grid.Column="1" Width="440" MaxDropDownHeight="520"
                          ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                          IsEnabled="{Binding IsIdle}" VerticalContentAlignment="Center"
                          ToolTip="Model dla czatu i zakładki Code: modele komputera, który liczy, i dodane w Ustawieniach modele w chmurze (kolorowe). Gwiazdka = ulubiony, na górze listy.">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ModelItem}">
                            <DockPanel>
                                <!-- Gwiazdka tylko na rozwiniętej liście (w zamkniętym polu nie ma ComboBoxItem). -->
                                <Button DockPanel.Dock="Left" Margin="-4,0,4,0" Tag="{Binding IsFavorite}"
                                        Command="{Binding FavoriteCommand}" CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StarButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"
                                         Fill="{Binding NameBrush}" Visibility="{Binding IsCloud, Converter={StaticResource BoolToVis}}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCloud}" Value="True">
                                                    <Setter Property="Foreground" Value="{Binding NameBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Odśwież" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            ToolTip="Sprawdź jeszcze raz Ollamę (albo inny komputer) i listę modeli" />
                    <CheckBox Style="{StaticResource SwitchToggle}" Content="Odblokuj dostęp do internetu" Margin="16,0,0,0"
                              IsChecked="{Binding InternetAccess}" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center"
                              ToolTip="Czat i zakładka Code mogą szukać w internecie (DuckDuckGo) i czytać strony. Umiejętność cde — nigdy (dane z bazy nie mogą wyjść do wyszukiwarki). Adresy w sieci biura są zablokowane." />
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="{Binding OllamaStatus}" Foreground="{Binding OllamaStatusBrush}"
                               FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding GpuText}" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" />
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <Button Content="Zwolnij pamięć GPU" Command="{Binding UnloadCommand}"
                            ToolTip="Wyrzuca model z pamięci karty graficznej tego komputera, np. przed pracą w Tekli albo RFEM. Następne pytanie załaduje go ponownie." />
                </StackPanel>
            </Grid>

            <!-- Baner: co zrobić, gdy Ollama (albo inny komputer) nie odpowiada lub brakuje modelu -->
            <Border Grid.Row="1" Margin="0,0,0,10" Padding="12,10" CornerRadius="6"
                    Background="{StaticResource WarningBackBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                    Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="Uruchom Ollamę" Command="{Binding StartOllamaCommand}" Margin="0,0,8,0"
                                Visibility="{Binding CanStartOllama, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Kopiuj polecenie instalacji" Command="{Binding CopyInstallCommand}" Margin="0,0,8,0"
                                Visibility="{Binding ShowInstallHint, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Pobierz model" Command="{Binding PullCommand}" Margin="0,0,8,0"
                                Visibility="{Binding CanPull, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Sprawdź ponownie" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" Foreground="{StaticResource WarningTextBrush}" />
                        <ProgressBar Height="6" Margin="0,6,0,0" Maximum="100" Value="{Binding PullPercent, Mode=OneWay}"
                                     Visibility="{Binding IsPulling, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TabControl x:Name="Tabs" Grid.Row="2">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </ControlTemplate>
                </TabControl.Template>
                <!-- ===== Czat ===== -->
                <TabItem x:Name="ChatTab" Header="Czat">
                    <!-- Panel rozmów (jak w Code) i rozmowa. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" MinWidth="160" MaxWidth="480" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:ChatSidebar x:Name="ChatSidebar" Grid.Column="0" />
                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                                      ToolTip="Przeciągnij, żeby zmienić szerokość panelu rozmów" />
                        <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" Padding="14,12"
                                              ScrollChanged="Transcript_ScrollChanged" PreviewMouseWheel="Transcript_PreviewMouseWheel">
                                    <ItemsControl ItemsSource="{Binding Exchanges}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ExchangeViewModel}">
                                                <StackPanel Margin="0,0,0,18">
                                                    <Border Background="{StaticResource SelectedBrush}" CornerRadius="6" Padding="12,8" HorizontalAlignment="Left">
                                                        <StackPanel>
                                                            <TextBlock Text="Ty" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}" />
                                                            <TextBox Text="{Binding Question, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="{StaticResource TileBrush}" BorderBrush="{StaticResource RowLineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding ModelLabel}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{Binding LabelBrush, TargetNullValue={StaticResource MutedBrush}}" />
                                                            <!-- Odpowiedź w Markdownie: tabele, listy, pogrubienia (menu pod prawym przyciskiem: tabele do Excela). -->
                                                            <hw:MarkdownText Markdown="{Binding Answer, Mode=OneWay}">
                                                                <hw:MarkdownText.Style>
                                                                    <Style TargetType="hw:MarkdownText">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </hw:MarkdownText.Style>
                                                            </hw:MarkdownText>
                                                            <TextBlock Text="{Binding Stats}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Text="{Binding EmptyChatHint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="480" IsHitTestVisible="False"
                                           Visibility="{Binding IsTranscriptEmpty, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="QuestionBox" Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="220"
                                         VerticalScrollBarVisibility="Auto"
                                         PreviewKeyDown="QuestionBox_PreviewKeyDown" DataObject.Pasting="QuestionBox_Pasting" />
                                <TextBlock Text="Zadaj pytanie…  (Enter wysyła, Shift+Enter nowa linia)" Margin="9,7,0,0"
                                           Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=QuestionBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <Button Content="Wyślij" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}"
                                        Width="120" Height="36" />
                                <Button Content="Stop" Command="{Binding StopCommand}" Width="120" Margin="0,8,0,0"
                                        ToolTip="Przerywa odpowiedź albo pobieranie (Esc)" />
                            </StackPanel>
                        </Grid>

                        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
                            <CheckBox Content="Pamiętaj rozmowę" IsChecked="{Binding RememberConversation}" VerticalAlignment="Center"
                                      IsEnabled="{Binding IsIdle}"
                                      ToolTip="Wysyłaj modelowi wcześniejsze pytania i odpowiedzi. Wyłączone: każde pytanie liczy się od zera." />
                            <Button DockPanel.Dock="Right" Content="Nowa rozmowa" Command="{Binding ClearCommand}"
                                    ToolTip="Czyści okno i zaczyna nową rozmowę — bieżąca zostaje zapisana w panelu rozmów" />
                        </DockPanel>
                    </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== Code: asystent wykonujący polecenia ===== -->
                <TabItem x:Name="CodeTab" Header="Code">
                    <local:HarnessView x:Name="CodeView" />
                </TabItem>

                <!-- ===== Ustawienia ===== -->
                <TabItem x:Name="SettingsTab" Header="Ustawienia">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel x:Name="SettingsPanel">
                            <!-- Gdzie liczyć -->
                            <Expander x:Name="SectionCompute" Style="{StaticResource PanelExpander}" Header="Gdzie liczyć" Tag="{Binding ComputeWhereText}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                                               Text="Dotyczy czatu, zakładki Code i programów, które łączą się przez LokalneAI. Twoja rozmowa (kontekst) zostaje na tym komputerze; wybrany komputer tylko liczy odpowiedź i niczego nie zapisuje." />
                                    <RadioButton Content="Na tym komputerze" IsChecked="{Binding Network.ComputeHere}" Margin="0,0,0,6" />
                                    <WrapPanel>
                                        <RadioButton Content="Na innym komputerze w sieci:" IsChecked="{Binding Network.ComputeElsewhere}" VerticalAlignment="Center" />
                                        <TextBox Width="230" Margin="8,0,0,0"
                                                 Text="{Binding Network.RemoteAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Nazwa komputera (np. PC-ODS12) albo adres IP (np. 10.0.0.50). Port tylko wtedy, gdy inny niż 11435 (10.0.0.50:12000)." />
                                        <Button Content="Połącz" Command="{Binding Network.ConnectCommand}" Margin="8,0,0,0"
                                                ToolTip="Sprawdza, czy tamten komputer ma LokalneAI i udostępnia model, i od razu przełącza liczenie" />
                                        <Button Content="Szukaj w sieci" Command="{Binding Network.FindCommand}" Margin="8,0,0,0"
                                                ToolTip="Pokazuje komputery z tej podsieci, które udostępniają model" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Network.RemoteDescription}" TextWrapping="Wrap" Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Network.RemoteOk}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Network.RemoteDescription}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Network.SearchText}" Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Network.SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Network.Peers}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <Button DockPanel.Dock="Right" Content="Użyj" Padding="10,2" MinHeight="24"
                                                            Command="{Binding DataContext.Network.UsePeerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                               Text="Treść zapytań idzie przez sieć biura bez szyfrowania (jak pliki na dysku sieciowym). Nie wybieraj innego komputera do pytań o dane, których jego właściciel nie powinien widzieć." />
                                </StackPanel>
                            </Expander>

                            <!-- Modele w chmurze -->
                            <Expander x:Name="SectionCloud" Style="{StaticResource PanelExpander}" Header="Modele w chmurze (test)" Tag="{Binding Cloud.Summary}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,6"
                                               Text="Do testów obsługi programów przez AI. Pytanie, rozmowa, wyniki poleceń i dokumentacja umiejętności idą przez internet do dostawcy, a rachunek przychodzi za zużycie. Zasada biura: z chmury tylko Claude (Anthropic), GPT (OpenAI) i Gemini (Google); umiejętność cde — tylko modele lokalne i Claude; DeepSeek wyłącznie lokalnie. Modele w chmurze liczą się prosto z tego komputera, bez kolejki i bez innych komputerów." />
                                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                                               Text="Logowanie: programy łączą się kluczem API, nie kontem claude.ai, ChatGPT ani Gemini — abonament ich nie obejmuje. Klucz zakłada się w konsoli dostawcy (przycisk „Załóż klucz…”), wkleja tutaj i zapisuje; program szyfruje go Twoim kontem Windows i nigdzie nie wysyła poza dostawcę." />
                                    <ItemsControl ItemsSource="{Binding Cloud.Providers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:CloudProviderRow}">
                                                <Border BorderBrush="{StaticResource RowLineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,8">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding Brush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding KeyStatus}" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <WrapPanel Margin="0,8,0,0">
                                                            <TextBlock Text="Klucz API" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <PasswordBox x:Name="KeyBox" Width="300"
                                                                         ToolTip="Wklej klucz API (np. z konsoli dostawcy). Po zapisaniu pole się czyści; klucz jest zaszyfrowany kontem Windows." />
                                                            <Button Content="Zapisz i sprawdź" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                                                                    Command="{Binding SaveKeyCommand}" CommandParameter="{Binding ElementName=KeyBox}"
                                                                    ToolTip="Zapisuje klucz i pobiera listę modeli (to nic nie kosztuje)" />
                                                            <Button Content="Pobierz listę modeli" Margin="8,0,0,0" Command="{Binding FetchCommand}" />
                                                            <Button Content="Usuń klucz" Margin="8,0,0,0" Command="{Binding RemoveKeyCommand}" />
                                                            <Button Content="Załóż klucz…" Margin="8,0,0,0" Command="{Binding OpenKeysPageCommand}" ToolTip="{Binding KeysPage}" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Status}" Margin="0,6,0,0" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding AllowedIn}" Style="{StaticResource Note}" Margin="0,4,0,0" />
                                                        <ItemsControl ItemsSource="{Binding Models}" Margin="0,6,0,0" MaxHeight="170">
                                                            <ItemsControl.Template>
                                                                <ControlTemplate>
                                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                        <ItemsPresenter />
                                                                    </ScrollViewer>
                                                                </ControlTemplate>
                                                            </ItemsControl.Template>
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type local:CloudModelRow}">
                                                                    <CheckBox Content="{Binding Display}" IsChecked="{Binding IsAdded}" Width="340" Margin="0,2,8,2"
                                                                              ToolTip="Zaznaczony = na liście modeli na górze okna" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <WrapPanel Margin="0,6,0,0">
                                                            <TextBlock Text="Dodaj model po id" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}" />
                                                            <TextBox Width="240" Text="{Binding ManualModel, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="Gdy modelu nie ma na liście dostawcy, np. nowa wersja. Id jak w dokumentacji dostawcy." />
                                                            <Button Content="Dodaj" Margin="8,0,0,0" Command="{Binding AddManualCommand}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>

                            <!-- Menedżer poświadczeń: wpisy w Menedżerze poświadczeń Windows, jeden wiersz = jeden wpis. -->
                            <Expander x:Name="SectionCredentials" Style="{StaticResource PanelExpander}" Header="Menedżer poświadczeń" Tag="{Binding Credentials.Summary}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                                               Text="Adresy, loginy i hasła są w Menedżerze poświadczeń Windows (Panel sterowania → Menedżer poświadczeń → Poświadczenia ogólne, wpisy „Amadeusz:…”), zaszyfrowane Twoim kontem Windows — nie w ustawieniach programu i nie w repozytorium. Wiersz zapisuje się, gdy z niego wyjdziesz; bazę PostgreSQL program od razu sprawdza (tylko odczyt). Umiejętność, która potrzebuje bazy, pojawia się w zakładce Code, gdy jest tu jej baza." />
                                    <ItemsControl ItemsSource="{Binding Credentials.Rows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Background="Transparent" IsKeyboardFocusWithinChanged="CredentialRow_FocusChanged">
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="TextBlock" x:Key="RowLabel">
                                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                                <Setter Property="Margin" Value="8,0,5,0" />
                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <TextBlock Text="typ" Style="{StaticResource RowLabel}" Margin="0,0,5,0" />
                                                        <ComboBox Width="100" ItemsSource="{x:Static local:CredentialsViewModel.Kinds}" DisplayMemberPath="Value"
                                                                  SelectedValuePath="Key" SelectedValue="{Binding Kind}" />
                                                        <TextBlock Text="IP" Style="{StaticResource RowLabel}" />
                                                        <TextBox Width="150" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="{Binding AddressHint}" />
                                                        <TextBlock Text="nazwa bazy" Style="{StaticResource RowLabel}" Visibility="{Binding PostgresOnly}" />
                                                        <TextBox Width="80" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding PostgresOnly}"
                                                                 ToolTip="Nazwa bazy — po niej umiejętność znajduje poświadczenie (np. umiejętność cde → baza „cde”)" />
                                                        <TextBlock Text="user" Style="{StaticResource RowLabel}" />
                                                        <TextBox Width="90" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Text="hasło" Style="{StaticResource RowLabel}" />
                                                        <Grid Width="105">
                                                            <PasswordBox PasswordChanged="CredentialPassword_Changed" Loaded="CredentialPassword_Loaded"
                                                                         ToolTip="Puste pole = zostaje zapisane hasło. Hasło nie wraca do okna." />
                                                            <TextBlock Text="{Binding PasswordHint}" IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource MutedBrush}" />
                                                        </Grid>
                                                        <TextBlock Text="person_id" Style="{StaticResource RowLabel}" Visibility="{Binding PostgresOnly}" />
                                                        <TextBox Width="115" Text="{Binding PersonId, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding PostgresOnly}"
                                                                 ToolTip="Twój identyfikator w tej bazie (np. person_id) — asystent pyta o „moje” dane. Można zostawić puste." />
                                                        <Button Content="×" Width="28" Margin="6,0,0,0" Padding="0" FontSize="15" Command="{Binding RemoveCommand}"
                                                                ToolTip="Usuń wpis (z Menedżera poświadczeń Windows)" />
                                                        <TextBlock Text="{Binding State}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StateIsError}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel Margin="0,2,0,0">
                                        <Button Content="+" Width="36" FontSize="15" Padding="0,1" Command="{Binding Credentials.AddCommand}" ToolTip="Dodaj wpis" />
                                        <Button Content="Wczytaj z pliku…" Margin="8,0,0,0" Command="{Binding Credentials.ImportCommand}"
                                                ToolTip="Plik JSON z polami host, port, dbname, user, password → nowy wpis PostgreSQL (pliku konta administratora program nie wczyta)" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Credentials.Status}" Margin="0,8,0,0" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Credentials.StatusIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Credentials.Status}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Expander>

                            <!-- Umiejętności: lista, źródła wiedzy (repozytoria, pliki na dysku), folder, aktualizacja dokumentacji. -->
                            <Expander x:Name="SectionSkills" Style="{StaticResource PanelExpander}" Header="Umiejętności" Tag="{Binding Skills.Summary}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                                               Text="Umiejętność to folder w „profile” obok programu (polecenia, wiedza, przykłady). „Źródła wiedzy…” — repozytoria, z których dokumentacja pobiera się sama (co 6 godzin przy użyciu), i pliki na dysku, np. wspólny glosariusz biura. „Aktualizuj” pobiera dokumentację od razu." />
                                    <ItemsControl ItemsSource="{Binding Skills.Rows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource RowLineBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Źródła wiedzy…" Padding="8,2" Margin="8,0,0,0" Command="{Binding SourcesCommand}"
                                                                    ToolTip="Repozytoria i adresy z dokumentacją oraz pliki i foldery na dysku (np. wspólny glosariusz)" />
                                                            <Button Content="Otwórz folder" Padding="8,2" Margin="6,0,0,0" Command="{Binding OpenFolderCommand}"
                                                                    ToolTip="{Binding Folder}" />
                                                            <Button Content="Aktualizuj" Padding="8,2" Margin="6,0,0,0" Command="{Binding SyncCommand}"
                                                                    ToolTip="Pobiera teraz nowe wersje dokumentacji z repozytoriów tej umiejętności" />
                                                        </StackPanel>
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="110" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                                                            <TextBlock Text="{Binding SourcesSummary}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Aktualizuj wszystkie" Padding="8,2" Command="{Binding Skills.SyncAllCommand}"
                                                ToolTip="Pobiera dokumentację wszystkich umiejętności, które mają źródła w repozytoriach" />
                                        <Button Content="Otwórz folder umiejętności" Padding="8,2" Margin="8,0,0,0" Command="{Binding Skills.OpenRootCommand}"
                                                ToolTip="{Binding Skills.SkillsRoot}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Skills.Status}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Expander>

                            <!-- Profile: nazwane zestawy umiejętności (zakładka Code → lista „Profil”). Jeden wiersz = jeden profil. -->
                            <Expander x:Name="SectionWorkProfiles" Style="{StaticResource PanelExpander}" Header="Profile" Tag="{Binding WorkProfiles.Summary}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                                               Text="Profil to gotowy zestaw umiejętności do trybu pracy i lista preferowanych modeli (od najlepszego). W zakładce Code wybór profilu zaznacza jego umiejętności i przełącza na pierwszy z modeli, który jest na maszynie liczącej (gdy żadnego nie ma — zostaje bieżący). Potem wszystko można jeszcze zmienić. Zmiany tutaj zapisują się od razu (nazwa — po wyjściu z pola)." />
                                    <ItemsControl ItemsSource="{Binding WorkProfiles.Rows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBox DockPanel.Dock="Left" Width="150" VerticalAlignment="Top"
                                                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}" ToolTip="Nazwa profilu na liście w zakładce Code" />
                                                    <Button DockPanel.Dock="Right" Content="×" Width="28" Padding="0" FontSize="15" VerticalAlignment="Top"
                                                            Margin="6,0,0,0" Command="{Binding RemoveCommand}" ToolTip="Usuń profil (umiejętności i rozmowy zostają)" />
                                                    <!-- Preferowane modele (od najlepszego) — osobne okno z kolejnością ↑/↓. -->
                                                    <Button DockPanel.Dock="Right" Width="250" Margin="8,0,0,0" Padding="8,2" HorizontalContentAlignment="Left"
                                                            Command="{Binding EditModelsCommand}"
                                                            ToolTip="Preferowane modele od najlepszego: wybór profilu przełącza na pierwszy dostępny na maszynie liczącej. Kliknij, żeby zmienić kolejność.">
                                                        <TextBlock Text="{Binding ModelsSummary}" TextTrimming="CharacterEllipsis" />
                                                    </Button>
                                                    <!-- Umiejętności: lista rozwijana z wielokrotnym wyborem (jak w zakładce Code). -->
                                                    <Grid Margin="8,0,0,0" VerticalAlignment="Top">
                                                        <ToggleButton x:Name="SkillsToggle" MinHeight="28" Padding="8,3" HorizontalContentAlignment="Stretch"
                                                                      ToolTip="Kliknij, żeby wybrać umiejętności profilu (kilka naraz)">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="Box" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                                                                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
                                                                    <Style.Triggers>
                                                                        <!-- Kliknięcie przy otwartej liście ma ją zamknąć, a nie otworzyć od nowa. -->
                                                                        <DataTrigger Binding="{Binding IsOpen, ElementName=SkillsPopup}" Value="True">
                                                                            <Setter Property="IsHitTestVisible" Value="False" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                           VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" />
                                                                <TextBlock Text="{Binding SkillsSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                        </ToggleButton>
                                                        <Popup x:Name="SkillsPopup" PlacementTarget="{Binding ElementName=SkillsToggle}" Placement="Bottom" VerticalOffset="2"
                                                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                                               IsOpen="{Binding IsChecked, ElementName=SkillsToggle, Mode=TwoWay}">
                                                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                                    CornerRadius="4" Padding="10,6" MinWidth="{Binding ActualWidth, ElementName=SkillsToggle}">
                                                                <StackPanel>
                                                                    <ItemsControl ItemsSource="{Binding Skills}" Focusable="False">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" ToolTip="{Binding Description}"
                                                                                          Margin="0,4,0,4" VerticalAlignment="Center" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <TextBlock Text="{Binding UnknownText}" Margin="0,4,0,2" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="260"
                                                                               ToolTip="Tych umiejętności nie ma na tym komputerze — profil je zachowuje (mogą być na innym)" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel Margin="0,2,0,0">
                                        <Button Content="+" Width="36" FontSize="15" Padding="0,1" Command="{Binding WorkProfiles.AddCommand}" ToolTip="Dodaj profil" />
                                        <Button Content="Przywróć domyślne" Margin="8,0,0,0" Command="{Binding WorkProfiles.RestoreDefaultsCommand}"
                                                ToolTip="Dopisuje domyślne profile (Konstruktor, Biuro, Baza CDE, Komputer), których nie ma na liście; istniejących nie zmienia" />
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>

                            <!-- OCR: Tesseract skryptem (umiejętność „ocr”, PDF w „office”, obrazek wklejony do pola rozmowy) -->
                            <Expander x:Name="SectionOcr" Style="{StaticResource PanelExpander}" Header="OCR" Tag="{Binding Ocr.Summary}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Note}" Margin="0,0,0,8"
                                               Text="Tekst ze skanów, zdjęć i PDF-ów bez warstwy tekstowej rozpoznaje Tesseract 5 (skrypt, bez modelu językowego; strony PDF renderuje PDFium). Te ustawienia dostają umiejętność „ocr”, polecenia PDF umiejętności „office” oraz OCR obrazka wklejonego do pola rozmowy (Ctrl+V w Code albo w Czacie). Tabele, wzory i rysunki OCR oddaje słabo — do nich model z obsługą obrazów." />
                                    <TextBlock Grid.Row="1" Text="Języki" Margin="0,4,12,0" VerticalAlignment="Center" />
                                    <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
                                        <TextBox Width="110" Text="{Binding Ocr.Languages, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Kody Tesseracta połączone plusem: pol+eng (polski z angielskim), deu, ces, ukr… Brakujące dane pobiera przycisk albo program przy pierwszym użyciu." />
                                        <TextBlock Text="Obrót strony" VerticalAlignment="Center" Margin="18,0,6,0" />
                                        <ComboBox Width="170" ItemsSource="{x:Static local:OcrViewModel.RotationChoices}" DisplayMemberPath="Key" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Ocr.Rotation}" ToolTip="Wykrywanie orientacji potrzebuje danych „osd”; przy bardzo małej ilości tekstu strona idzie bez obrotu." />
                                        <TextBlock Text="Układ" VerticalAlignment="Center" Margin="18,0,6,0" />
                                        <ComboBox Width="230" ItemsSource="{x:Static local:OcrViewModel.LayoutChoices}" DisplayMemberPath="Key" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Ocr.Layout}" ToolTip="Tabela: odstępy między kolumnami zostają, więc wiersz tabeli to jedna linia. Luźny tekst: pieczątki, adnotacje, numery na zdjęciach." />
                                    </WrapPanel>
                                    <TextBlock Grid.Row="2" Text="Filtry" Margin="0,10,12,0" VerticalAlignment="Center" />
                                    <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                                        <TextBlock Text="Pomijaj słowa o pewności poniżej" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Width="44" Text="{Binding Ocr.MinConfidenceText, UpdateSourceTrigger=LostFocus}" ToolTip="0–100; 0 = nic nie pomijaj. Wynik mówi, ile słów pominięto." />
                                        <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <TextBlock Text="Rozdzielczość PDF" VerticalAlignment="Center" Margin="18,0,6,0" />
                                        <ComboBox Width="70" ItemsSource="{x:Static local:OcrViewModel.DpiChoices}" SelectedItem="{Binding Ocr.Dpi}"
                                                  ToolTip="Punkty na cal przy renderowaniu stron PDF do OCR: 300 dla druku, 400–600 dla drobnych tabelek rysunkowych, 150–200 szybciej." />
                                        <TextBlock Text="dpi" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <CheckBox Content="Strony PDF bez tekstu czytaj przez OCR" IsChecked="{Binding Ocr.WhenNoText}" VerticalAlignment="Center" Margin="18,0,0,0"
                                                  ToolTip="pdf_czytaj: strona ze skanu (bez warstwy tekstowej) jest renderowana i rozpoznawana sama" />
                                        <CheckBox Content="Wklejony obrazek → OCR do pola rozmowy" IsChecked="{Binding Ocr.OnPaste}" VerticalAlignment="Center" Margin="18,0,0,0"
                                                  ToolTip="Ctrl+V z obrazkiem w polu rozmowy (Code, Czat): obraz zapisuje się w folderze rozmowy, a rozpoznany tekst trafia do pola z nagłówkiem" />
                                    </WrapPanel>
                                    <TextBlock Grid.Row="3" Text="Ignoruj linie" Margin="0,10,12,0" VerticalAlignment="Top" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Text="{Binding Ocr.IgnorePatterns, UpdateSourceTrigger=LostFocus}"
                                             AcceptsReturn="True" TextWrapping="NoWrap" Height="56" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                             ToolTip="Wyrażenia regularne, po jednym w linii; linia wyniku pasująca do któregoś znika. Przykłady: ^Strona \d+ z \d+$   ^ODS Sp\. z o\.o\.   znak wodny" />
                                    <TextBlock Grid.Row="4" Text="Dane języków" Margin="0,10,12,0" VerticalAlignment="Center" />
                                    <WrapPanel Grid.Row="4" Grid.Column="1" Margin="0,10,0,0">
                                        <TextBox Width="360" Text="{Binding Ocr.TessdataFolder, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Folder z plikami *.traineddata; puste = %LOCALAPPDATA%\LokalneAI\tessdata" />
                                        <Button Content="Pobierz brakujące" Padding="8,2" Margin="8,0,0,0" Command="{Binding Ocr.DownloadCommand}"
                                                ToolTip="Pobiera dane wybranych języków i wykrywania orientacji z tessdata_fast (GitHub, Apache 2.0), kilka MB na język" />
                                        <Button Content="Otwórz folder" Padding="8,2" Margin="6,0,0,0" Command="{Binding Ocr.OpenFolderCommand}" ToolTip="{Binding Ocr.TessdataPath}" />
                                        <Button Content="Próba na pliku…" Padding="8,2" Margin="6,0,0,0" Command="{Binding Ocr.TestCommand}"
                                                ToolTip="Wybierz obraz albo PDF (pierwsza strona) i zobacz, co rozpoznaje OCR z tymi ustawieniami" />
                                    </WrapPanel>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Ocr.LanguagesStatus}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Grid.Row="6" Grid.ColumnSpan="2" Text="{Binding Ocr.Status, Mode=OneWay}" Margin="0,8,0,0" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto" Foreground="{StaticResource MutedBrush}" />
                                </Grid>
                            </Expander>

                            <!-- Udostępnianie -->
                            <Expander x:Name="SectionShare" Style="{StaticResource PanelExpander}" Header="Udostępnianie tego komputera" Tag="{Binding Network.ShareSummary}">
                                <StackPanel>
                                    <CheckBox Content="Pozwalaj na przeliczanie zapytań z innych komputerów (tylko z tej samej podsieci)"
                                              IsChecked="{Binding Network.ShareOnLan}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Network.GatewayText}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextBrush}" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Width="70" Text="{Binding Network.PortText, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Ten sam na wszystkich komputerach biura (domyślnie 11435). Zmiana wymaga ponownego otwarcia portu w zaporze." />
                                        <TextBlock Text="Największy kontekst dla innych" VerticalAlignment="Center" Margin="18,0,6,0" />
                                        <ComboBox Width="90" ItemsSource="{Binding Network.ContextChoices}" SelectedItem="{Binding Network.MaxContextForOthers}"
                                                  ToolTip="Dłuższy kontekst zajmuje więcej pamięci karty. Zapytanie z dłuższym dostaje czytelny błąd, nie jest obcinane." />
                                    </WrapPanel>
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="Otwórz port w zaporze…" Command="{Binding Network.FirewallCommand}" Margin="10,0,0,0" VerticalAlignment="Top"
                                                ToolTip="Jednorazowo, wymaga zgody administratora: reguła tylko dla podsieci i tylko w sieciach prywatnych/domenowych" />
                                        <TextBlock Text="{Binding Network.FirewallText}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                               Text="Zapytania z tego komputera mają pierwszeństwo; zapytanie innego komputera po minucie czekania wraca do zwykłej kolejności. Inni nie mogą pobierać ani usuwać modeli. Treści cudzych zapytań nie są nigdzie zapisywane; w kolejce widać tylko, kto, czym i kiedy pyta." />
                                </StackPanel>
                            </Expander>

                            <!-- Kolejka -->
                            <Expander x:Name="SectionQueue" Style="{StaticResource PanelExpander}" Header="Kolejka" Tag="{Binding Network.QueueSummary}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Text="Wszystkie zapytania przez LokalneAI: z czatu, z zakładki Code, z innych programów na tym komputerze i z innych komputerów." />
                                    <TextBlock Text="Nic nie czeka i nic nie liczy." Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                                               Visibility="{Binding Network.IsQueueEmpty, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding Network.Queue}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:QueueRow}">
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="240" />
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Who}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Program}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Model}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding StateText}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="4" Content="Odrzuć" Padding="10,2" MinHeight="24"
                                                            Visibility="{Binding CanReject, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.Network.RejectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Network.Activity}" Margin="0,8,0,0" MaxHeight="140">
                                        <ItemsControl.Template>
                                            <ControlTemplate>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>

                            <!-- Czat -->
                            <Expander x:Name="SectionChat" Style="{StaticResource PanelExpander}" Header="Czat" Tag="{Binding ChatSummary}">
                                <Grid IsEnabled="{Binding IsIdle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="1" Text="Polecenie systemowe" Margin="0,4,12,0" VerticalAlignment="Top" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto"
                                             ToolTip="Instrukcja dla modelu dodawana przed każdym pytaniem. Puste pole = bez instrukcji." />
                                    <TextBlock Grid.Row="2" Text="Parametry" Margin="0,10,12,0" VerticalAlignment="Center" />
                                    <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                                        <TextBlock Text="Temperatura" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Width="56" Text="{Binding TemperatureText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="0 = zawsze ta sama odpowiedź, wyżej = swobodniej. SpeakLeash zaleca dla Bielika 0,1." />
                                        <TextBlock Text="Kontekst" VerticalAlignment="Center" Margin="18,0,6,0" />
                                        <ComboBox Width="90" ItemsSource="{Binding ContextChoices}" SelectedItem="{Binding ContextLength}"
                                                  ToolTip="Ile tokenów model widzi naraz. Więcej = więcej pamięci karty graficznej i wolniej. Zakładka Code używa co najmniej 16 384." />
                                        <CheckBox Content="Zapisuj historię na tym PC" IsChecked="{Binding SaveHistory}"
                                                  VerticalAlignment="Center" Margin="18,0,0,0" ToolTip="{Binding HistoryPath}" />
                                    </WrapPanel>
                                </Grid>
                            </Expander>

                            <!-- Ollama na tym komputerze -->
                            <Expander x:Name="SectionOllama" Style="{StaticResource PanelExpander}" Header="Ollama na tym komputerze" Tag="{Binding OllamaUrl}">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Adres" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Width="320" Text="{Binding OllamaUrl, UpdateSourceTrigger=LostFocus}"
                                                 IsEnabled="{Binding IsIdle}"
                                                 ToolTip="Zwykle http://127.0.0.1:11434. Tu liczy ten komputer — także zapytania innych, gdy udostępniasz." />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Text="{Binding GatewayHint}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

        </Grid>

        <!-- Pasek stanu -->
        <DockPanel Grid.Row="2" Margin="16,0">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="{Binding Network.QueueText}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="{Binding ComputeWhereText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ComputeWhereBrush}" Margin="14,0,0,0" />
            <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
        </DockPanel>
    </Grid>
</Window>
