<Window x:Class="LokalneAI.App.HarnessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LokalneAI.App"
        Title="LokalneAI — Code"
        Width="900" Height="780" MinWidth="600" MinHeight="500"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Ta sama zakładka Code co w oknie głównym, w osobnym oknie (np. obok Tekli), z własną rozmową. -->
    <Grid x:Name="Root" Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Background="{StaticResource AccentDarkBrush}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimalizuj" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maksymalizuj" />
                <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Zamknij" />
            </StackPanel>
            <TextBlock Margin="16,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="White" Text="LokalneAI — Code" />
        </DockPanel>
        <local:HarnessView x:Name="View" Grid.Row="1" Margin="14,12,14,14" />
    </Grid>
</Window>
