<UserControl x:Class="LokalneAI.App.HarnessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LokalneAI.App"
             xmlns:wpf="clr-namespace:LokalneAI.Harness.Wpf;assembly=LokalneAI.Harness.Wpf"
             >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="250" MinWidth="160" MaxWidth="480" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Panel rozmów: grupy = foldery robocze; rozmowy grupy leżą w <folder>\.amadeusz\. -->
        <Border Grid.Column="0" Style="{StaticResource PanelBox}" Padding="8">
            <DockPanel>
                <Button DockPanel.Dock="Top" x:Name="NewConversationButton" Content="+ Nowa rozmowa" Padding="8,5" HorizontalAlignment="Stretch"
                        Click="NewConversation_Click" ToolTip="Nowa rozmowa w zaznaczonej grupie (folderze)" />
                <Button DockPanel.Dock="Bottom" Content="+ Nowa grupa (folder)…" Margin="0,8,0,0" Padding="8,3" HorizontalAlignment="Stretch"
                        Click="AddGroup_Click"
                        ToolTip="Wskaż folder roboczy: asystent będzie w nim pracował (dozwolony folder), a rozmowy grupy zapisze w jego podfolderze .amadeusz" />
                <TextBlock DockPanel.Dock="Bottom" x:Name="SidebarHint" Margin="2,6,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" />
                <TreeView x:Name="ConversationTree" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                          SelectedItemChanged="Tree_SelectedItemChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="2,3" />
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeItem_RightClick" />
                        </Style>
                        <HierarchicalDataTemplate DataType="{x:Type local:ConversationGroupNode}" ItemsSource="{Binding Conversations}">
                            <DockPanel ToolTip="{Binding Tooltip}" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Margin="6,0,0,0" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type local:ConversationNode}">
                            <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource RowDeleteButton}" Click="TrashButton_Click"
                                    ToolTip="Usuń rozmowę (do kosza .amadeusz\kosz — kasowana po 7 dniach)" />
                            <TextBlock Text="{Binding DisplayTitle}" ToolTip="{Binding Tooltip}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>
        </Border>
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                      ToolTip="Przeciągnij, żeby zmienić szerokość panelu rozmów" />

        <DockPanel Grid.Column="2">
            <!-- Umiejętności (lista rozwijana z wielokrotnym wyborem), uprawnienia i wykonawca. W prawdziwym programie robi to gospodarz w kodzie. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource PanelBox}" Padding="12,10">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="Profil" VerticalAlignment="Center" Margin="0,0,8,0"
                                   ToolTip="Gotowy zestaw umiejętności do danego trybu pracy. Wybór zaznacza umiejętności — potem można je zmienić." />
                        <ComboBox x:Name="WorkProfileBox" Width="160" Margin="0,0,14,0" SelectionChanged="WorkProfile_Changed"
                                  ToolTip="Wybierz profil — zaznaczy swoje umiejętności" />
                        <TextBlock Text="Umiejętności" VerticalAlignment="Center" Margin="0,0,8,0"
                                   ToolTip="Co asystent umie. Można wybrać kilka naraz — wtedy obowiązują najostrzejsze zasady z nich (np. cde wyłącza internet)." />
                        <Grid VerticalAlignment="Center">
                            <ToggleButton x:Name="SkillsButton" Width="240" MinHeight="28" Padding="8,3" HorizontalContentAlignment="Stretch"
                                          ToolTip="Kliknij, żeby wybrać umiejętności (kilka naraz)">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="SkillsSummary" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </ToggleButton>
                            <Popup x:Name="SkillsPopup" PlacementTarget="{Binding ElementName=SkillsButton}" Placement="Bottom" VerticalOffset="2"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{Binding IsChecked, ElementName=SkillsButton, Mode=TwoWay}">
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="10,6" MinWidth="{Binding ActualWidth, ElementName=SkillsButton}">
                                    <StackPanel>
                                        <StackPanel x:Name="ProfilesPanel" />
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,6" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <Button Content="Zapisz jako profil…" Padding="8,2" Click="SaveWorkProfile_Click"
                                                    ToolTip="Zaznaczone umiejętności zapisuje jako profil (nowy albo o tej samej nazwie — zastąpiony)" />
                                            <Button x:Name="DeleteWorkProfileButton" Content="Usuń profil" Padding="8,2" Margin="6,0,0,0"
                                                    Click="DeleteWorkProfile_Click" ToolTip="Usuwa wybrany profil z listy (umiejętności zostają zaznaczone)" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Uprawnienia" VerticalAlignment="Center" Margin="10,0,6,0" />
                            <ComboBox x:Name="PermissionBox" Width="210" SelectionChanged="Permission_Changed">
                                <ComboBoxItem Tag="czyta" Content="Tylko czyta"
                                              ToolTip="Asystent czyta i odpowiada. Gdy potrzebuje coś zmienić, pyta o wyjątek dla tego jednego polecenia; Nie = odrzucone." />
                                <ComboBoxItem Tag="pytaj" Content="Pyta o każdą zmianę"
                                              ToolTip="Przed każdą zmianą (plik, folder, model Tekli, program) pojawia się okienko Tak/Nie. Zalecane." />
                                <ComboBoxItem Tag="bez" Content="Bez pytania (poza kasowaniem)"
                                              ToolTip="Zmiany wykonują się od razu; kasowanie i inne ryzykowne polecenia nadal pytają. Działa do zamknięcia programu." />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Kontekst" VerticalAlignment="Center" Margin="14,0,6,0" />
                            <ComboBox x:Name="ContextBox" Width="130" SelectionChanged="Context_Changed"
                                      ToolTip="Ile tokenów mieści jedno zapytanie w zakładce Code: zasady, narzędzia i wiedza umiejętności (2–8 tys.) plus rozmowa. Więcej = dłuższa rozmowa, ale wolniej i więcej pamięci karty. Przy liczeniu na innym komputerze nie więcej, niż on przyjmuje („kontekst do”).">
                                <ComboBoxItem Tag="0" Content="jak w Czacie"
                                              ToolTip="Kontekst z Ustawienia → Czat, ale co najmniej 16 384 (dotychczasowe zachowanie)." />
                                <ComboBoxItem Tag="8192" Content="8 192"
                                              ToolTip="Mało: zasady większych umiejętności (Tekla, RFEM, Office) mogą się nie zmieścić — Ollama ucina początek po cichu." />
                                <ComboBoxItem Tag="16384" Content="16 384" />
                                <ComboBoxItem Tag="32768" Content="32 768"
                                              ToolTip="Przy trzech i więcej umiejętnościach naraz albo długich rozmowach. Na karcie 8 GB większy model nie zmieści się cały w pamięci karty." />
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="SkillSearchBox" Content="Szukaj brakujących umiejętności" VerticalAlignment="Center" Margin="14,0,0,0"
                                  Checked="SkillSearch_Changed" Unchecked="SkillSearch_Changed"
                                  ToolTip="Gdy model nie ma polecenia do zadania, szuka w niezaznaczonych umiejętnościach i prosi o ich włączenie (przycisk w rozmowie). Każda włączona umiejętność powiększa polecenie systemowe — przy małym kontekście może go zapchać. Domyślnie wyłączone." />
                        <CheckBox x:Name="StepsBox" Content="Pokaż kroki modelu" VerticalAlignment="Center" Margin="14,0,0,0"
                                  Checked="Steps_Changed" Unchecked="Steps_Changed"
                                  ToolTip="Wpis „Krok N” po każdej odpowiedzi modelu: wywołania, odpowiedź, pytanie albo plan; surowy JSON w szczegółach. Ten sam przełącznik: Ustawienia → Czat → Diagnostyka. Wpisy zapisują się zawsze — to tylko widok." />
                    </WrapPanel>
                    <!-- Źródła wiedzy i aktualizacja dokumentacji: Ustawienia → Umiejętności. -->
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock x:Name="ModelText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    </WrapPanel>
                    <WrapPanel x:Name="TeklaOptions" Margin="0,8,0,0">
                        <RadioButton x:Name="SimulatorRadio" Content="Symulator (bez Tekli)" IsChecked="True" VerticalAlignment="Center" Checked="Executor_Changed" />
                        <RadioButton x:Name="BridgeRadio" Content="TeklaBridge — folder wymiany:" Margin="14,0,6,0" VerticalAlignment="Center" Checked="Executor_Changed" />
                        <TextBox x:Name="ExchangeBox" Width="330" VerticalContentAlignment="Center" LostFocus="Executor_Changed" />
                    </WrapPanel>
                    <WrapPanel x:Name="CdeOptions" Margin="0,8,0,0">
                        <TextBlock x:Name="CdeText" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="Poświadczenia…" Padding="8,2" Click="CdeSettings_Click"
                                ToolTip="Ustawienia → Menedżer poświadczeń: adres, nazwa bazy, użytkownik, hasło i Twój person_id (w Menedżerze poświadczeń Windows)" />
                    </WrapPanel>
                    <StackPanel x:Name="FilesOptions" Margin="0,8,0,0">
                        <WrapPanel>
                            <TextBlock Text="Dozwolone foldery (rozdziel ;):" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="RootsBox" Width="420" VerticalContentAlignment="Center" LostFocus="Executor_Changed"
                                     ToolTip="Asystent czyta, tworzy, kopiuje, przenosi i wykonuje polecenia tylko w tych folderach (z podfolderami). Programy może uruchamiać też z Program Files. Folder grupy rozmowy jest dozwolony zawsze." />
                        </WrapPanel>
                        <TextBlock x:Name="WorkFolderText" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- Model w chmurze: dokąd idą dane (kolor dostawcy) albo ostrzeżenie, że profil na niego nie pozwala. -->
                    <Border x:Name="CloudBar" Margin="0,8,0,0" Padding="10,6" CornerRadius="4" BorderThickness="3,0,0,0"
                            Background="{StaticResource TileBrush}" Visibility="Collapsed">
                        <TextBlock x:Name="CloudText" TextWrapping="Wrap" FontSize="12" />
                    </Border>
                    <TextBlock x:Name="HintText" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <wpf:HarnessPanel x:Name="Panel" />
        </DockPanel>
    </Grid>
</UserControl>
