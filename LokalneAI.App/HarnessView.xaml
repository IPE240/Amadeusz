<UserControl x:Class="LokalneAI.App.HarnessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:LokalneAI.Harness.Wpf;assembly=LokalneAI.Harness.Wpf"
             >
    <DockPanel>
        <!-- Profil, uprawnienia i wykonawca. W prawdziwym programie robi to gospodarz w kodzie. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelBox}" Padding="12,10">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Profil" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="ProfileBox" Width="130" SelectionChanged="Profile_Changed"
                              ToolTip="Co asystent umie: tekla (polecenia w modelu), cde (pytania do bazy), pliki, komputer (PowerShell, programy)" />
                    <TextBlock Text="Uprawnienia" VerticalAlignment="Center" Margin="14,0,6,0" />
                    <ComboBox x:Name="PermissionBox" Width="210" SelectionChanged="Permission_Changed">
                        <ComboBoxItem Tag="czyta" Content="Tylko czyta"
                                      ToolTip="Polecenia, które coś zmieniają, są odrzucane bez pytania. Asystent może tylko czytać i odpowiadać." />
                        <ComboBoxItem Tag="pytaj" Content="Pyta o każdą zmianę"
                                      ToolTip="Przed każdą zmianą (plik, folder, model Tekli, program) pojawia się okienko Tak/Nie. Zalecane." />
                        <ComboBoxItem Tag="bez" Content="Bez pytania (poza kasowaniem)"
                                      ToolTip="Zmiany wykonują się od razu; kasowanie i inne ryzykowne polecenia nadal pytają. Działa do zamknięcia programu." />
                    </ComboBox>
                    <CheckBox x:Name="StepsBox" Content="Pokaż kroki modelu (JSON)" VerticalAlignment="Center" Margin="14,0,0,0"
                              Checked="Steps_Changed" Unchecked="Steps_Changed" />
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Źródła wiedzy…" Padding="8,2" Click="Sources_Click"
                            ToolTip="Repozytoria i adresy, z których asystent bierze dokumentację (wklej link do repozytorium)" />
                    <Button x:Name="SyncButton" Content="Aktualizuj wiedzę" Margin="6,0,0,0" Padding="8,2" Click="Sync_Click"
                            ToolTip="Pobiera nowe wersje dokumentacji z repozytoriów wpisanych w zrodla.json profilu" />
                    <Button x:Name="WindowButton" Content="W osobnym oknie" Margin="6,0,0,0" Padding="8,2" Click="OpenWindow_Click"
                            ToolTip="Drugi asystent w osobnym oknie (własna rozmowa), np. obok Tekli" />
                    <TextBlock x:Name="ModelText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource MutedBrush}" />
                </WrapPanel>
                <WrapPanel x:Name="TeklaOptions" Margin="0,8,0,0">
                    <RadioButton x:Name="SimulatorRadio" Content="Symulator (bez Tekli)" IsChecked="True" VerticalAlignment="Center" Checked="Executor_Changed" />
                    <RadioButton x:Name="BridgeRadio" Content="TeklaBridge — folder wymiany:" Margin="14,0,6,0" VerticalAlignment="Center" Checked="Executor_Changed" />
                    <TextBox x:Name="ExchangeBox" Width="330" VerticalContentAlignment="Center" LostFocus="Executor_Changed" />
                </WrapPanel>
                <WrapPanel x:Name="CdeOptions" Margin="0,8,0,0">
                    <TextBlock Text="Plik połączenia z bazą (JSON):" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="ConnectionBox" Width="330" VerticalContentAlignment="Center" LostFocus="Executor_Changed" />
                    <Button Content="Wybierz…" Margin="6,0,0,0" Padding="8,2" Click="PickConnection_Click" />
                    <TextBlock Text="Twój person_id:" VerticalAlignment="Center" Margin="14,0,6,0" />
                    <TextBox x:Name="PersonBox" Width="260" VerticalContentAlignment="Center" LostFocus="Executor_Changed" />
                </WrapPanel>
                <WrapPanel x:Name="FilesOptions" Margin="0,8,0,0">
                    <TextBlock Text="Dozwolone foldery (rozdziel ;):" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="RootsBox" Width="420" VerticalContentAlignment="Center" LostFocus="Executor_Changed"
                             ToolTip="Asystent czyta, tworzy, kopiuje, przenosi i wykonuje polecenia tylko w tych folderach (z podfolderami). Programy może uruchamiać też z Program Files. Pierwszy folder jest bieżącym na start." />
                </WrapPanel>
                <TextBlock x:Name="HintText" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <wpf:HarnessPanel x:Name="Panel" />
    </DockPanel>
</UserControl>
