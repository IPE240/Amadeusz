<Window x:Class="LokalneAI.App.PreferredModelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferowane modele"
        Width="620" Height="470" MinWidth="460" MinHeight="360"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" CornerRadius="0" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource AccentDarkBrush}" BorderThickness="1">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Height="42" Background="{StaticResource AccentDarkBrush}">
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Content="&#xE8BB;" IsCancel="True" Click="Cancel_Click" ToolTip="Zamknij" />
                <TextBlock Margin="16,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="White"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
            </DockPanel>
            <DockPanel Margin="16,14,16,16">
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Od najlepszego do najsłabszego. Wybór profilu w zakładce Code przełącza na pierwszy model z listy, który jest na maszynie liczącej; gdy żadnego nie ma — zostaje bieżący model. Model w chmurze tylko wtedy, gdy pozwalają na niego umiejętności profilu (np. cde — tylko Claude) i jest klucz API." />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="OK" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Anuluj" Width="90" Click="Cancel_Click" />
                </StackPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="Dodaj" Width="80" Margin="8,0,0,0" Click="Add_Click" />
                    <ComboBox x:Name="ChoiceBox" IsEditable="True" DisplayMemberPath="Display" StaysOpenOnEdit="True"
                              ToolTip="Model z listy okna albo wpisana nazwa (np. gemma4:12b) — może go nie być na tym komputerze" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button Content="↑ wyżej" Width="90" Margin="0,0,0,6" Click="Up_Click" />
                    <Button Content="↓ niżej" Width="90" Margin="0,0,0,6" Click="Down_Click" />
                    <Button Content="× usuń" Width="90" Click="Remove_Click" />
                </StackPanel>
                <ListBox x:Name="ChosenList" DisplayMemberPath="Display" Background="{StaticResource SurfaceBrush}"
                         BorderBrush="{StaticResource LineBrush}" />
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
