<Window x:Class="LokalneAI.App.SourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Źródła wiedzy"
        Width="860" Height="640" MinWidth="560" MinHeight="420"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <!-- Jak okna dialogowe TransmittalMaster: ramka systemowa ukryta, Windows rysuje cień wokół okna. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" CornerRadius="0" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource AccentDarkBrush}" BorderThickness="1">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Height="42" Background="{StaticResource AccentDarkBrush}">
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="CloseWindow_Click" ToolTip="Zamknij" />
                <TextBlock Margin="16,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="White" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
            </DockPanel>
            <DockPanel Margin="16,14,16,16">
                <TextBlock x:Name="IntroText" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Dodaj wiersz" Margin="0,0,8,0" Click="Add_Click" />
                        <Button Content="Usuń zaznaczony" Margin="0,0,8,0" Click="Remove_Click" />
                        <Button x:Name="SaveButton" Content="Zapisz i pobierz" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
                        <Button Content="Zamknij" IsCancel="True" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" TextWrapping="Wrap" />
                </DockPanel>
                <!-- Pliki i foldery na dysku (np. wspólny glosariusz biura): ścieżki tylko w ustawieniach tego komputera. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <TextBlock Text="Pliki i foldery na dysku" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,6"
                               Text="Np. wspólny glosariusz biura na serwerze — jeden plik dla wszystkich. Program czyta go przy każdej nowej sesji (pliki .md, .txt, .tsv, .csv; z folderu — wszystkie takie pliki), a kopię trzyma na tym komputerze na wypadek, gdy dysk jest niedostępny. Plik z parami terminów w wierszach („expansion joint – kompensator”) działa jako glosariusz: asystent sam dostaje odpowiedniki terminów z tłumaczonego tekstu. Ścieżki zapisują się tylko na tym komputerze (nie w repozytorium)." />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Dodaj" Margin="0,0,6,0" Click="AddDiskPath_Click" ToolTip="Dodaj ścieżkę wpisaną w polu" />
                            <Button Content="Plik…" Margin="0,0,6,0" Click="BrowseDiskFile_Click" />
                            <Button Content="Folder…" Click="BrowseDiskFolder_Click" />
                        </StackPanel>
                        <TextBox x:Name="DiskPathBox" VerticalContentAlignment="Center"
                                 ToolTip="Wklej ścieżkę, np. \\serwer\biuro\glosariusz.txt albo X:\Wspólne\Słowniki" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Usuń zaznaczoną" Margin="8,0,0,0" VerticalAlignment="Top" Click="RemoveDiskPath_Click" />
                        <ListBox x:Name="DiskList" Height="64" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" />
                    </DockPanel>
                </StackPanel>
                <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource RowLineBrush}"
                          Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" RowHeight="28">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Repozytorium albo adres pliku" Binding="{Binding Adres, UpdateSourceTrigger=PropertyChanged}" Width="3*" />
                        <DataGridTextColumn Header="Gałąź" Binding="{Binding Galaz, UpdateSourceTrigger=PropertyChanged}" Width="1*" />
                        <DataGridTextColumn Header="Pliki (rozdziel ;)" Binding="{Binding Pliki, UpdateSourceTrigger=PropertyChanged}" Width="2.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
