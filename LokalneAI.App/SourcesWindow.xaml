<Window x:Class="LokalneAI.App.SourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Źródła wiedzy"
        Width="860" Height="440" MinWidth="560" MinHeight="300"
        FontFamily="Segoe UI" FontSize="13" Background="#F4F5F7"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Padding="12" Background="#F4F5F7">
    <DockPanel>
        <TextBlock x:Name="IntroText" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#374151" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#6B7280" Margin="0,0,12,0" TextWrapping="Wrap" MaxWidth="420" />
            <Button Content="Dodaj wiersz" Padding="10,3" Margin="0,0,8,0" Click="Add_Click" />
            <Button Content="Usuń zaznaczony" Padding="10,3" Margin="0,0,8,0" Click="Remove_Click" />
            <Button x:Name="SaveButton" Content="Zapisz i pobierz" Padding="10,3" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
            <Button Content="Zamknij" Padding="10,3" IsCancel="True" />
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" Background="White" BorderBrush="#DDE1E6" RowHeight="26">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Repozytorium albo adres pliku" Binding="{Binding Adres, UpdateSourceTrigger=PropertyChanged}" Width="3*" />
                <DataGridTextColumn Header="Gałąź" Binding="{Binding Galaz, UpdateSourceTrigger=PropertyChanged}" Width="1*" />
                <DataGridTextColumn Header="Pliki (rozdziel ;)" Binding="{Binding Pliki, UpdateSourceTrigger=PropertyChanged}" Width="2.5*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
    </Border>
</Window>
