<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Ikona w zasobniku (NotifyIcon). Bez globalnych using WinForms/Drawing — nazwy kolidowałyby z WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LokalneAI</AssemblyName>
    <RootNamespace>LokalneAI.App</RootNamespace>
    <Version>0.1.0</Version>
    <Product>LokalneAI</Product>
    <Company>Optimal Design of Structures Sp. z o.o.</Company>
    <Copyright>Copyright (c) 2026 Optimal Design of Structures Sp. z o.o.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LokalneAI.Core\LokalneAI.Core.csproj" />
    <ProjectReference Include="..\LokalneAI.Gateway\LokalneAI.Gateway.csproj" />
    <ProjectReference Include="..\LokalneAI.Harness\LokalneAI.Harness.csproj" />
    <ProjectReference Include="..\LokalneAI.Harness.Office\LokalneAI.Harness.Office.csproj" />
    <ProjectReference Include="..\LokalneAI.Harness.Ocr\LokalneAI.Harness.Ocr.csproj" />
    <ProjectReference Include="..\LokalneAI.Harness.Rfem\LokalneAI.Harness.Rfem.csproj" />
    <ProjectReference Include="..\LokalneAI.Harness.Postgres\LokalneAI.Harness.Postgres.csproj" />
    <ProjectReference Include="..\LokalneAI.Harness.Wpf\LokalneAI.Harness.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- Po każdym zbudowaniu (Debug) odświeża Amadeusz.exe w głównym folderze repozytorium. Pomijane przy samej
       publikacji (instalator, ten skrypt) i w buildach projektowych (podpowiedzi edytora). Błąd nie psuje budowania. -->
  <Target Name="OdswiezAmadeusza" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' and '$(AmadeuszPublikacja)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\narzedzia\odswiez_amadeusza.ps1&quot;"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- Sylwetka Mozarta do ikony w zasobniku (bez pliku — sylwetka zastępcza narysowana w kodzie). -->
    <Resource Include="Assets\mozart.png" Condition="Exists('Assets\mozart.png')" />
  </ItemGroup>

</Project>
